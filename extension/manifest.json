{
  "manifest_version": 3,
  "name": "BrowserMCP",
  "version": "0.2.8",
  "description": "Lets a local MCP companion automate and debug tabs you explicitly share.",
  "permissions": ["debugger", "tabs", "storage", "alarms", "downloads"],
  "background": { "service_worker": "dist/background.js" },
  "action": { "default_title": "Open BrowserMCP", "default_icon": "assets/logo.png" },
  "icons": { "16": "assets/logo.png", "32": "assets/logo.png", "48": "assets/logo.png", "128": "assets/logo.png" }
}
