{
  "name": "browsermcp",
  "version": "0.2.8",
  "private": true,
  "type": "module",
  "bin": {
    "browsermcp": "companion/src/index.ts"
  },
  "scripts": {
    "build": "bun build extension/src/background.ts extension/src/app.ts --outdir extension/dist --target browser",
    "typecheck": "tsc --noEmit -p companion && tsc --noEmit -p extension",
    "test": "bun test --timeout 120000",
    "start": "bun companion/src/index.ts",
    "package": "bun run build && mkdir -p dist && rm -f dist/browsermcp-extension.zip && cd extension && zip -qr ../dist/browsermcp-extension.zip manifest.json app.html app.css assets dist && cd .. && ls -la dist/browsermcp-extension.zip",
    "capabilities": "bun companion/test/capabilities.ts",
    "test:e2e": "E2E=1 bun test --timeout 120000",
    "compile": "bun build --compile companion/src/index.ts --outfile dist/browsermcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "ws": "^8.18.0",
    "zod": "^4.6.2",
    "lighthouse": "^12.8.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
